PORT=3000
UTILES_PATH=./UtilesEscolares.xlsx

# Token de verificacion del webhook (tu lo eliges, debe coincidir en Meta)
VERIFY_TOKEN=cambia-este-token

# Secreto de app de Meta (opcional, activa validacion de firmas)
APP_SECRET=

# Datos de la API de WhatsApp Cloud (los obtienes en Meta for Developers)
PHONE_NUMBER_ID=
ACCESS_TOKEN=

# Version de la Graph API (usar version estable reciente)
GRAPH_VERSION=v22.0

# ---- YCloud (BSP para coexistencia con la app WhatsApp Business) ----
# API key de YCloud (ycloud.com -> Developers -> API Keys)
YCLOUD_API_KEY=
# Numero de negocio en formato E.164 con prefijo + (ej: +593987695938)
YCLOUD_PHONE=
# Secreto del endpoint webhook de YCloud (opcional, activa validacion de firmas YCloud-Signature)
YCLOUD_WEBHOOK_SECRET=

# ---- Google Gemini (IA opcional para el flujo de utiles) ----
# API key gratuita en https://aistudio.google.com/apikey. Sin esta clave el bot
# sigue funcionando 100% con las reglas actuales (flujo de utiles sin IA).
GEMINI_API_KEY=
# Modelo gratuito con vision. No cambiar salvo que sepas lo que haces.
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Ventas utiles escolares ----
# Recargo fijo por entrega a domicilio (USD). Se suma al TOTAL de la cotizacion
# final y al anticipo del 50% cuando el cliente elige entrega a domicilio.
DOMICILIO_RECARGO=3